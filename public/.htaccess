# CastFlow Studio - Apache / LiteSpeed / uPress / cPanel Rewrite Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Security: Protect sensitive files and data
  RewriteRule ^data/.*\.json$ - [F,L]
  RewriteRule ^(\.git|\.env|key\.pem|cert\.pem) - [F,L]

  # Allow direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Support PHP APIs if available
  RewriteCond %{DOCUMENT_ROOT}/api/$1/index.php -f
  RewriteRule ^api/(.*)$ api/$1/index.php [L,QSA]

  # Route HTML pages directly if static export
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # Single Page App routing fallback
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# MIME Types & Encoding
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType audio/wav .wav
</IfModule>

# Enable GZIP Compression for Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# CORS & Browser Security Headers
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>
