          "text": "הראשיות ענה על הציפיות"
        },
        {
          "id": "sub_1788007937964_20",
          "startTime": null,
          "endTime": null,
          "text": "שלכם בצפייה הראשונה?. נושא"
        },
        {
          "id": "sub_1788007937964_21",
          "startTime": null,
          "endTime": null,
          "text": "2: ניתוח דמויות, קונפליקטים"
        },
        {
          "id": "sub_1788007937964_22",
          "startTime": null,
          "endTime": null,
          "text": "ותמות מרכזיות. המסע הפנימי"
        },
        {
          "id": "sub_1788007937964_23",
          "startTime": null,
          "endTime": null,
          "text": "של הדמות הראשית והמחיר"
        },
        {
          "id": "sub_1788007937964_24",
          "startTime": null,
          "endTime": null,
          "text": "האישי שהיא משלמת לאורך"
        },
        {
          "id": "sub_1788007937964_25",
          "startTime": null,
          "endTime": null,
          "text": "הסיפור.. הקונפליקט המוסרי שמוצג"
        },
        {
          "id": "sub_1788007937964_26",
          "startTime": null,
          "endTime": null,
          "text": "ביצירה והשאלות האנושיות שהיא"
        },
        {
          "id": "sub_1788007937964_27",
          "startTime": null,
          "endTime": null,
          "text": "מעלה.. הסמליות והרמזים המקדימים"
        },
        {
          "id": "sub_1788007937964_28",
          "startTime": null,
          "endTime": null,
          "text": "ששזורים בעלילה לקראת רגעי"
        },
        {
          "id": "sub_1788007937964_29",
          "startTime": null,
          "endTime": null,
          "text": "השיא.. מהו לדעתכם הרגע"
        },
        {
          "id": "sub_1788007937964_30",
          "startTime": null,
          "endTime": null,
          "text": "הרגשי החזק ביותר שמגדיר"
        },
        {
          "id": "sub_1788007937964_31",
          "startTime": null,
          "endTime": null,
          "text": "את הסרט?. האם הבחירות"
        },
        {
          "id": "sub_1788007937964_32",
          "startTime": null,
          "endTime": null,
          "text": "המוסריות של הגיבור מוצדקות"
        },
        {
          "id": "sub_1788007937964_33",
          "startTime": null,
          "endTime": null,
          "text": "בעיניכם בסיום היצירה?. נושא"
        },
        {
          "id": "sub_1788007937964_34",
          "startTime": null,
          "endTime": null,
          "text": "3: מאחורי הקלעים, אתגרי"
        },
        {
          "id": "sub_1788007937964_35",
          "startTime": null,
          "endTime": null,
          "text": "הפקה ושפת הבימוי. בנובמבר"
        },
        {
          "id": "sub_1788007937964_36",
          "startTime": null,
          "endTime": null,
          "text": "2024 חשף רידלי סקוט"
        },
        {
          "id": "sub_1788007937964_37",
          "startTime": null,
          "endTime": null,
          "text": "לראשונה בריאיון כי בין"
        },
        {
          "id": "sub_1788007937964_38",
          "startTime": null,
          "endTime": null,
          "text": "הסרטים העתידיים שהוא מתכנן"
        },
        {
          "id": "sub_1788007937964_39",
          "startTime": null,
          "endTime": null,
          "text": "נמצא גם סרט מדע"
        },
        {
          "id": "sub_1788007937964_40",
          "startTime": null,
          "endTime": null,
          "text": "בדיוני שדבר קיומו לא"
        },
        {
          "id": "sub_1788007937964_41",
          "startTime": null,
          "endTime": null,
          "text": "נודע עד אז, והצהיר"
        },
        {
          "id": "sub_1788007937964_42",
          "startTime": null,
          "endTime": null,
          "text": "כי התסריט כבר כתוב.."
        },
        {
          "id": "sub_1788007937964_43",
          "startTime": null,
          "endTime": null,
          "text": "השפה הויזואלית, זוויות הצילום"
        },
        {
          "id": "sub_1788007937964_44",
          "startTime": null,
          "endTime": null,
          "text": "והתאורה שנבחרו לבניית המתח.."
        },
        {
          "id": "sub_1788007937964_45",
          "startTime": null,
          "endTime": null,
          "text": "הפסקול והעיצוב הקולי והאופן"
        },
        {
          "id": "sub_1788007937964_46",
          "startTime": null,
          "endTime": null,
          "text": "שבו הם מעצימים את"
        },
        {
          "id": "sub_1788007937964_47",
          "startTime": null,
          "endTime": null,
          "text": "חוויית הצפייה.. כיצד שפת"
        },
        {
          "id": "sub_1788007937964_48",
          "startTime": null,
          "endTime": null,
          "text": "הצילום והעיצוב הויזואלי תרמו"
        },
        {
          "id": "sub_1788007937964_49",
          "startTime": null,
          "endTime": null,
          "text": "לתחושת ההזדהות של הצופה?."
        },
        {
          "id": "sub_1788007937964_50",
          "startTime": null,
          "endTime": null,
          "text": "איזה פרט מאחורי הקלעים"
        },
        {
          "id": "sub_1788007937964_51",
          "startTime": null,
          "endTime": null,
          "text": "הפתיע אתכם ביותר במהלך"
        },
        {
          "id": "sub_1788007937964_52",
          "startTime": null,
          "endTime": null,
          "text": "המחקר על ההפקה?. נושא"
        },
        {
          "id": "sub_1788007937964_53",
          "startTime": null,
          "endTime": null,
          "text": "4: קבלת היצירה בציבור,"
        },
        {
          "id": "sub_1788007937964_54",
          "startTime": null,
          "endTime": null,
          "text": "סיום והמלצה סופית. כיצד"
        },
        {
          "id": "sub_1788007937964_55",
          "startTime": null,
          "endTime": null,
          "text": "התקבלה היצירה על ידי"
        },
        {
          "id": "sub_1788007937964_56",
          "startTime": null,
          "endTime": null,
          "text": "קהל הצופים ומבקרי הקולנוע"
        },
        {
          "id": "sub_1788007937964_57",
          "startTime": null,
          "endTime": null,
          "text": "בעולם.. הוויכוחים והפרשנויות השונות"
        },
        {
          "id": "sub_1788007937964_58",
          "startTime": null,
          "endTime": null,
          "text": "שנוצרו סביב סצנת הסיום.."
        },
        {
          "id": "sub_1788007937964_59",
          "startTime": null,
          "endTime": null,
          "text": "פסק הדין הסופי: למי"
        },
        {
          "id": "sub_1788007937964_60",
          "startTime": null,
          "endTime": null,
          "text": "היצירה מומלצת והציון המסכם"
        },
        {
          "id": "sub_1788007937964_61",
          "startTime": null,
          "endTime": null,
          "text": "מתוך עשר.. איך אתם"
        },
        {
          "id": "sub_1788007937964_62",
          "startTime": null,
          "endTime": null,
          "text": "מפרשים את המסר הסופי"
        },
        {
          "id": "sub_1788007937964_63",
          "startTime": null,
          "endTime": null,
          "text": "שהבמאי בחר להשאיר עם"
        },
        {
          "id": "sub_1788007937964_64",
          "startTime": null,
          "endTime": null,
          "text": "הצופים?. איזה ציון מגיע"
        },
        {
          "id": "sub_1788007937964_65",
          "startTime": null,
          "endTime": null,
          "text": "ליצירה זו בעיניכם, ולמי"
        },
        {
          "id": "sub_1788007937964_66",
          "startTime": null,
          "endTime": null,
          "text": "הייתם ממליצים לצפות בה?"
        }
